<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SqlServerBridge.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="SqlServerBridge.Tests/**" />
    <Content Remove="SqlServerBridge.Tests/**" />
    <EmbeddedResource Remove="SqlServerBridge.Tests/**" />
    <None Remove="SqlServerBridge.Tests/**" />
  </ItemGroup>

</Project>
